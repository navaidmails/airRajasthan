# Database Configuration (MySQL)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"

# Authentication & Session Security
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
NODE_ENV="development"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Email / Notification Provider (Disabled in demo mode)
# In demo mode, notification jobs are safely persisted to the database with status "NOT_CONFIGURED"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@airrajasthan.com"

# Demo Account Seeding Credentials (Used exclusively by `npm run seed`)
# Seed command must be explicitly executed in development; never run in production.
SEED_ADMIN_EMAIL="admin@airrajasthan.com"
SEED_ADMIN_PASSWORD="AdminSecurePassword2026!"
SEED_TEAM_EMAIL="team@airrajasthan.com"
SEED_TEAM_PASSWORD="TeamSecurePassword2026!"
SEED_USER_EMAIL="client@logistics-partner.com"
SEED_USER_PASSWORD="ClientSecurePassword2026!"
